{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "actions",
    "reply",
    "heard"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "enum": [
        "control",
        "question",
        "clarify"
      ]
    },
    "reply": {
      "type": "string",
      "maxLength": 350
    },
    "actions": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "temperature",
              "fan",
              "ac",
              "defrost",
              "seatHeat",
              "media",
              "volume",
              "navigate",
              "navigationStop",
              "undo"
            ]
          },
          "zone": {
            "type": "string",
            "enum": [
              "driver",
              "passenger",
              "both"
            ]
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "string"
              }
            ]
          }
        }
      }
    },
    "heard": {
      "type": "string",
      "maxLength": 500
    }
  }
}
